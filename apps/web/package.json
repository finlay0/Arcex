{
  "name": "@arcex/web",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5174 --strictPort",
    "build": "tsc --noEmit && vite build",
    "build:accounts": "tsc --noEmit && vite build --mode accounts && node -e \"const fs = require('node:fs'); fs.copyFileSync('dist/account-site/_arcex-account/index.html', 'dist/account-site/index.html'); fs.copyFileSync('accounts.headers', 'dist/account-site/_headers')\"",
    "preview": "vite preview --port 5174 --strictPort"
  },
  "dependencies": {
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "geist": "^1.9.0",
    "lucide-react": "^1.67.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.4",
    "@types/node": "26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.1",
    "tailwindcss": "^4.3.4",
    "typescript": "7.0.2",
    "vite": "^8.3.5"
  }
}
